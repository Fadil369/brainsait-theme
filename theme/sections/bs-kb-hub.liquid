{% liquid
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif

  assign kb = blogs['knowledge-base']

  assign reports_count = 0
  assign write_ups_count = 0
  assign podcasts_count = 0
  assign videos_count = 0

  for a in kb.articles
    if a.tags contains 'report'
      assign reports_count = reports_count | plus: 1
    endif
    if a.tags contains 'article' or a.tags contains 'blog'
      assign write_ups_count = write_ups_count | plus: 1
    endif
    if a.tags contains 'podcast'
      assign podcasts_count = podcasts_count | plus: 1
    endif
    if a.tags contains 'video'
      assign videos_count = videos_count | plus: 1
    endif
  endfor
%}
{% # theme-check-disable ValidScopedCSSClass %}

<div class="bs-kb">
  <div class="bs-kb__hero page-width">
    <p class="bs-kb__eyebrow">
      {% if is_ar %}
        محتوى مجاني ومفتوح
      {% else %}
        Free & open resources
      {% endif %}
    </p>
    <h1 class="bs-kb__heading">
      {% if is_ar %}
        قاعدة معرفة BrainSAIT
      {% else %}
        BrainSAIT Knowledge Base
      {% endif %}
    </h1>
    <p class="bs-kb__subheading">
      {% if is_ar %}
        تقارير وأدلة، مقالات، حلقات بودكاست، وفيديوهات حول معرفات الكائنات (OID)، FHIR، NPHIES،
        وهندسة الهوية الرقمية — بالكامل مجاناً.
      {% else %}
        Reports and guides, articles, podcast episodes, and videos on object identifiers (OID), FHIR,
        NPHIES, and digital identity architecture — completely free.
      {% endif %}
    </p>
  </div>

  {% if reports_count > 0 %}
    <div class="bs-kb__category page-width">
      <div class="bs-kb__category-head">
        <h2>
          {% if is_ar %}
            تقارير وأدلة
          {% else %}
            Reports & Guides
          {% endif %}
        </h2>
      </div>
      <div class="bs-kb__grid">
        {% for article in kb.articles %}
          {% if article.tags contains 'report' %}
            {% render 'bs-kb-card', article: article, kicker_ar: 'تقرير', kicker_en: 'Report', icon: 'report', is_ar: is_ar %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if write_ups_count > 0 %}
    <div class="bs-kb__category page-width">
      <div class="bs-kb__category-head">
        <h2>
          {% if is_ar %}
            مقالات
          {% else %}
            Articles
          {% endif %}
        </h2>
      </div>
      <div class="bs-kb__grid">
        {% for article in kb.articles %}
          {% if article.tags contains 'article' or article.tags contains 'blog' %}
            {% render 'bs-kb-card', article: article, kicker_ar: 'مقالة', kicker_en: 'Article', icon: 'article', is_ar: is_ar %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if podcasts_count > 0 %}
    <div class="bs-kb__category page-width">
      <div class="bs-kb__category-head">
        <h2>
          {% if is_ar %}
            بودكاست
          {% else %}
            Podcasts
          {% endif %}
        </h2>
      </div>
      <div class="bs-kb__grid">
        {% for article in kb.articles %}
          {% if article.tags contains 'podcast' %}
            {% render 'bs-kb-card', article: article, kicker_ar: 'بودكاست', kicker_en: 'Podcast', icon: 'podcast', is_ar: is_ar %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if videos_count > 0 %}
    <div class="bs-kb__category page-width">
      <div class="bs-kb__category-head">
        <h2>
          {% if is_ar %}
            فيديوهات
          {% else %}
            Videos
          {% endif %}
        </h2>
      </div>
      <div class="bs-kb__grid">
        {% for article in kb.articles %}
          {% if article.tags contains 'video' %}
            {% render 'bs-kb-card', article: article, kicker_ar: 'فيديو', kicker_en: 'Video', icon: 'video', is_ar: is_ar %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .bs-kb__hero {
    padding-block: 4rem 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .bs-kb__eyebrow {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bs-accent);
  }

  .bs-kb__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    color: var(--color-foreground);
  }

  .bs-kb__subheading {
    margin: 0;
    max-width: 40rem;
    color: var(--bs-muted);
    line-height: 1.6;
  }

  .bs-kb__category {
    padding-block: 2rem;
  }

  .bs-kb__category-head {
    margin-block-end: 1.25rem;
  }

  .bs-kb__category-head h2 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.4rem;
    color: var(--color-foreground);
  }

  .bs-kb__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .bs-kb-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--bs-border);
    border-radius: var(--bs-radius-m);
    background-color: var(--bs-surface);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: var(--bs-mode-transition), border-color 0.2s ease, transform 0.15s ease;
  }

  .bs-kb-card:hover {
    border-color: var(--bs-accent);
    transform: translateY(-2px);
  }

  .bs-kb-card__media {
    aspect-ratio: 16 / 9;
    background-color: var(--bs-surface-2);
  }

  .bs-kb-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bs-kb-card__media--icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bs-accent);
  }

  .bs-kb-card__media--icon svg {
    width: 2.25rem;
    height: 2.25rem;
  }

  .bs-kb-card__body {
    padding: 1rem 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bs-kb-card__kicker {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bs-accent);
    font-weight: 600;
  }

  .bs-kb-card__title {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--color-foreground);
  }

  .bs-kb-card__excerpt {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--bs-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BrainSAIT KB Hub",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "BrainSAIT KB Hub"
    }
  ]
}
{% endschema %}
