{% liquid
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
  assign oid_collection = collections['oid-enterprise-identity']
%}
{% # theme-check-disable ValidScopedCSSClass %}

<div class="bs-oid-grid">
  <div class="bs-oid-grid__inner page-width">
    <div class="bs-oid-grid__header">
      <h2 class="bs-oid-grid__heading">
        {% if is_ar %}
          منتجات هوية الرعاية الصحية
        {% else %}
          Healthcare Identity Products
        {% endif %}
      </h2>
      {% if oid_collection != blank %}
        <a href="{{ oid_collection.url }}" class="bs-oid-grid__view-all">
          {% if is_ar %}عرض الكل{% else %}View all{% endif %}
        </a>
      {% endif %}
    </div>

    <ul class="bs-oid-grid__list" role="list">
      {% if oid_collection != blank %}
        {% for product in oid_collection.products limit: 8 %}
          {%- liquid
            assign badge_label = ''
            assign badge_class = ''

            if product.tags contains 'platform'
              if is_ar
                assign badge_label = 'مميز'
              else
                assign badge_label = 'Featured'
              endif
              assign badge_class = 'bs-oid-card__badge--featured'

            elsif product.tags contains 'self-hosted'
              if is_ar
                assign badge_label = 'معتمد نفيس'
              else
                assign badge_label = 'Certified'
              endif
              assign badge_class = 'bs-oid-card__badge--certified'

            elsif product.tags contains 'x509' and product.tags contains 'mcp'
              if is_ar
                assign badge_label = 'مفتوح المصدر'
              else
                assign badge_label = 'Open Source'
              endif
              assign badge_class = 'bs-oid-card__badge--opensource'

            elsif product.tags contains 'hipaa'
              if is_ar
                assign badge_label = 'جديد'
              else
                assign badge_label = 'New'
              endif
              assign badge_class = 'bs-oid-card__badge--new'
            endif
          -%}

          <li class="bs-oid-card">
            <a href="{{ product.url }}" class="bs-oid-card__link" aria-label="{{ product.title }}">
              <div class="bs-oid-card__media">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="400"
                    height="400"
                    loading="lazy"
                    class="bs-oid-card__img"
                  >
                {%- else -%}
                  <div class="bs-oid-card__placeholder" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <circle cx="12" cy="5" r="2.2"/>
                      <circle cx="5" cy="17" r="2.2"/>
                      <circle cx="19" cy="17" r="2.2"/>
                      <path d="M12 7.2 6.4 15M12 7.2l5.6 7.8M7.2 17h9.6"/>
                    </svg>
                  </div>
                {%- endif -%}

                {%- if badge_label != blank -%}
                  <span class="bs-oid-card__badge {{ badge_class }}" aria-label="{{ badge_label }}">
                    {{ badge_label }}
                  </span>
                {%- endif -%}
              </div>

              <div class="bs-oid-card__content">
                <h3 class="bs-oid-card__title">{{ product.title }}</h3>
                <p class="bs-oid-card__desc">{{ product.description | strip_html | truncate: 100 }}</p>
                <div class="bs-oid-card__price">{{ product.price | money }}</div>
              </div>
            </a>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .bs-oid-grid {
    padding-block: 3.5rem 4rem;
    background-color: var(--color-background, #0a0a0f);
  }

  .bs-oid-grid__inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .bs-oid-grid__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .bs-oid-grid__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-foreground, #f0f0ff);
  }

  .bs-oid-grid__view-all {
    font-size: 0.875rem;
    color: var(--bs-accent, #7c6fff);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.15s ease;
  }

  .bs-oid-grid__view-all:hover {
    opacity: 0.75;
  }

  .bs-oid-grid__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .bs-oid-grid__list {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
  }

  .bs-oid-card {
    position: relative;
  }

  .bs-oid-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    border-radius: 8px;
    border: 1px solid var(--bs-border, #2a2a3e);
    background-color: var(--bs-surface, #0d0d1a);
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .bs-oid-card__link:hover {
    border-color: rgba(124, 111, 255, 0.5);
    transform: translateY(-3px);
  }

  .bs-oid-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: rgba(124, 111, 255, 0.06);
  }

  .bs-oid-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bs-oid-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(124, 111, 255, 0.5);
  }

  .bs-oid-card__placeholder svg {
    width: 40%;
    height: 40%;
  }

  .bs-oid-card__badge {
    position: absolute;
    top: 0.5rem;
    inset-inline-end: 0.5rem;
    padding-inline: 0.55rem;
    padding-block: 0.25rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    pointer-events: none;
  }

  .bs-oid-card__badge--featured {
    background-color: #7c6fff;
    color: #ffffff;
  }

  .bs-oid-card__badge--certified {
    background-color: #22d3ee;
    color: #0a0a0f;
  }

  .bs-oid-card__badge--opensource {
    background-color: rgba(255,255,255,0.15);
    color: #f0f0ff;
    border: 1px solid rgba(255,255,255,0.3);
  }

  .bs-oid-card__badge--new {
    background-color: #10b981;
    color: #ffffff;
  }

  .bs-oid-card__content {
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .bs-oid-card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-foreground, #f0f0ff);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bs-oid-card__desc {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--bs-muted, rgba(240,240,255,0.55));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bs-oid-card__price {
    margin-block-start: auto;
    padding-block-start: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--bs-accent, #7c6fff);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BS OID Product Grid",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "BS OID Product Grid"
    }
  ]
}
{% endschema %}
