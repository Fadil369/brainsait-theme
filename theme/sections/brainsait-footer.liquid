      <a href="https://lark.brainsait.org" target="_blank" rel="noopener noreferrer" class="brainsait-footer__eco-link">Lark <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a>
    </div>
  </div>
</footer>

