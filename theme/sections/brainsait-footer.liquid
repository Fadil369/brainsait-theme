{%- comment -%}
  BrainSAIT Branded Footer — matches gh.io design system
  Premium luxury glass footer with navigation, ecosystem links, and branding.
  Standalone section — does not depend on default Publisher theme footer.
  Bilingual (AR/EN) with full RTL support.
{%- endcomment -%}

{% liquid
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
  assign locale_dir = 'ltr'
  if is_ar
    assign locale_dir = 'rtl'
  endif
%}

{% style %}
/* ── BrainSAIT Footer — gh.io Glass Design Tokens ────────────────── */

/* Dark theme (default) */
.brainsait-footer {
  --bs-bg: #0a0e18;
  --bs-bg-hover: rgba(255, 255, 255, 0.045);
  --bs-bg-hover-hover: rgba(255, 255, 255, 0.078);
  --bs-border: rgba(255, 255, 255, 0.08);
  --bs-border-hover: rgba(233, 196, 106, 0.4);
  --bs-ink: #e4e8f1;
  --bs-ink-soft: #a3aed0;
  --bs-ink-muted: #6e7a99;
  --bs-gold: #e9c46a;
  --bs-gold-grad: linear-gradient(120deg, #f5dd9d, #e9c46a);
  --bs-glass-bg: rgba(10, 14, 24, 0.88);
  --bs-glass-blur: saturate(135%) blur(10px);
  --bs-radius-sm: 6px;
  --bs-radius-md: 8px;
  --bs-radius-lg: 12px;
  --bs-transition: 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

/* Light theme */
[data-theme='light'] .brainsait-footer {
  --bs-bg: #ffffff;
  --bs-bg-hover: rgba(0, 0, 0, 0.035);
  --bs-bg-hover-hover: rgba(0, 0, 0, 0.065);
  --bs-border: rgba(18, 24, 52, 0.10);
  --bs-border-hover: rgba(196, 155, 62, 0.45);
  --bs-ink: #1f2937;
  --bs-ink-soft: #6b7280;
  --bs-ink-muted: #9ca3af;
  --bs-gold: #c49b3e;
  --bs-gold-grad: linear-gradient(120deg, #d4af37, #c49b3e);
  --bs-glass-bg: rgba(255, 255, 255, 0.88);
  --bs-glass-blur: saturate(180%) blur(12px);
}

/* Root container */
.brainsait-footer {
  background: var(--bs-bg);
  border-top: 1px solid var(--bs-border);
  padding: 56px 0 0;
  font-family: 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', 'Roboto', Arial, sans-serif;
  position: relative;
  direction: {{ locale_dir }};
  transition: background 0.35s ease, border-color 0.35s ease;
}

.brainsait-footer::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 50% at 50% -20%, rgba(233, 196, 106, 0.06), transparent),
    radial-gradient(ellipse 60% 40% at 20% 100%, rgba(59, 130, 246, 0.04), transparent);
  pointer-events: none;
  transition: opacity 0.35s ease;
}

[data-theme='light'] .brainsait-footer::before {
  background:
    radial-gradient(ellipse 80% 50% at 50% -20%, rgba(196, 155, 62, 0.05), transparent),
    radial-gradient(ellipse 60% 40% at 20% 100%, rgba(59, 130, 246, 0.03), transparent);
}

/* Inner grid */
.brainsait-footer__inner {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 24px;
  display: grid;
  grid-template-columns: 1.4fr repeat(3, 1fr);
  gap: 40px;
}

/* Brand column */
.brainsait-footer__brand {
  padding-top: 4px;
}

.brainsait-footer__brand-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: var(--bs-ink);
  margin-bottom: 14px;
}

.brainsait-footer__brand-icon {
  width: 36px;
  height: 36px;
  background: var(--bs-gold-grad);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
  transition: transform var(--bs-transition), box-shadow var(--bs-transition);
}

.brainsait-footer__brand-logo:hover .brainsait-footer__brand-icon {
  transform: scale(1.06);
  box-shadow: 0 2px 12px rgba(233, 196, 106, 0.3);
}

.brainsait-footer__brand-name {
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.brainsait-footer__brand-desc {
  color: var(--bs-ink-soft);
  font-size: 13px;
  line-height: 1.65;
  margin: 0 0 16px;
  max-width: 280px;
}

/* Column headings */
.brainsait-footer__col h4 {
  color: var(--bs-ink);
  font-size: 12.5px;
  font-weight: 700;
  margin: 0 0 16px;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  position: relative;
  padding-bottom: 10px;
}

.brainsait-footer__col h4::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 24px;
  height: 2px;
  background: var(--bs-gold-grad);
  border-radius: 1px;
  transition: width var(--bs-transition);
}

.brainsait-footer__col:hover h4::after {
  width: 36px;
}

/* Link lists */
.brainsait-footer__col ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.brainsait-footer__col li {
  margin-bottom: 0;
}

.brainsait-footer__col a {
  color: var(--bs-ink-soft);
  text-decoration: none;
  font-size: 13.5px;
  line-height: 1.6;
  display: inline-block;
  padding: 3px 0;
  transition: color var(--bs-transition), transform var(--bs-transition);
}

.brainsait-footer__col a:hover {
  color: var(--bs-gold);
  transform: translateX(2px);
}

[data-theme='light'] .brainsait-footer__col a:hover {
  color: var(--bs-gold);
}

[dir='rtl'] .brainsait-footer__col a:hover {
  transform: translateX(-2px);
}

/* Divider line between columns and bottom */
.brainsait-footer__divider {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  margin: 48px auto 0;
  padding: 0 24px;
}

.brainsait-footer__divider hr {
  border: none;
  height: 1px;
  background: var(--bs-border);
}

/* Bottom bar */
.brainsait-footer__bottom {
  position: relative;
  z-index: 1;
  max-width: 1240px;
  margin: 0 auto;
  padding: 24px 24px 20px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16px;
}

/* Copyright */
.brainsait-footer__copy {
  color: var(--bs-ink-muted);
  font-size: 12px;
  line-height: 1.6;
  margin: 0;
}

.brainsait-footer__copy a {
  color: var(--bs-ink-soft);
  text-decoration: none;
  transition: color var(--bs-transition);
}

.brainsait-footer__copy a:hover {
  color: var(--bs-gold);
}

/* Ecosystem links */
.brainsait-footer__ecosystem {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.brainsait-footer__eco-link {
  color: var(--bs-ink-soft);
  font-size: 11.5px;
  font-weight: 500;
  padding: 5px 11px;
  border-radius: var(--bs-radius-sm);
  border: 1px solid var(--bs-border);
  text-decoration: none;
  transition: all var(--bs-transition);
  white-space: nowrap;
  letter-spacing: 0.01em;
}

.brainsait-footer__eco-link:hover {
  background: var(--bs-bg-hover-hover);
  border-color: var(--bs-border-hover);
  color: var(--bs-gold);
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

[data-theme='light'] .brainsait-footer__eco-link:hover {
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

/* External link arrow */
.brainsait-footer__eco-link .eco-arrow {
  display: inline-block;
  margin-inline-start: 3px;
  opacity: 0.5;
  font-size: 10px;
  transition: opacity var(--bs-transition), transform var(--bs-transition);
}

.brainsait-footer__eco-link:hover .eco-arrow {
  opacity: 1;
}

[dir='rtl'] .brainsait-footer__eco-link .eco-arrow {
  transform: scaleX(-1);
}

/* Responsive */
@media screen and (max-width: 960px) {
  .brainsait-footer__inner {
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 24px;
  }
}

@media screen and (max-width: 640px) {
  .brainsait-footer {
    padding: 40px 0 0;
  }

  .brainsait-footer__inner {
    grid-template-columns: 1fr;
    gap: 28px;
    padding: 0 16px;
  }

  .brainsait-footer__bottom {
    padding: 20px 16px 16px;
    flex-direction: column;
    align-items: flex-start;
  }

  .brainsait-footer__ecosystem {
    gap: 5px;
  }

  .brainsait-footer__eco-link {
    font-size: 11px;
    padding: 4px 9px;
  }
}

/* Accessibility — reduced motion */
@media (prefers-reduced-motion: reduce) {
  .brainsait-footer a,
  .brainsait-footer__eco-link,
  .brainsait-footer__brand-icon,
  .brainsait-footer__col h4::after {
    transition: none;
  }

  .brainsait-footer__col a:hover {
    transform: none;
  }

  .brainsait-footer__eco-link:hover {
    transform: none;
  }
}

/* Focus visible */
.brainsait-footer a:focus-visible,
.brainsait-footer__eco-link:focus-visible {
  outline: 2px solid var(--bs-gold);
  outline-offset: 3px;
  border-radius: var(--bs-radius-sm);
}
{% endstyle %}

<footer class="brainsait-footer" role="contentinfo">
  <div class="brainsait-footer__inner">

    <!-- Brand Column -->
    <div class="brainsait-footer__brand">
      <a href="/" class="brainsait-footer__brand-logo" aria-label="BrainSAIT Home">
        <span class="brainsait-footer__brand-icon" aria-hidden="true">&#x1F9E1;</span>
        <span class="brainsait-footer__brand-name">BrainSAIT</span>
      </a>
      <p class="brainsait-footer__brand-desc">
        {% if is_ar %}
          المنصة الذكية لدمج وتخصيص أدوات العمل. تعلّم، ابنِ، احلّ.
        {% else %}
          The Resolution Platform — Learn, Build, Solutions.
        {% endif %}
      </p>
    </div>

    <!-- Store Column -->
    <div class="brainsait-footer__col">
      <h4>{% if is_ar %}المتجر{% else %}Store{% endif %}</h4>
      <ul>
        <li><a href="/collections/learn">{% if is_ar %}تعلّم{% else %}Learn{% endif %}</a></li>
        <li><a href="/collections/build">{% if is_ar %}ابنِ{% else %}Build{% endif %}</a></li>
        <li><a href="/collections/solutions">{% if is_ar %}حلول{% else %}Solutions{% endif %}</a></li>
        <li><a href="/collections/solutions-ready">{% if is_ar %}جاهز{% else %}Ready{% endif %}</a></li>
      </ul>
    </div>

    <!-- Support Column -->
    <div class="brainsait-footer__col">
      <h4>{% if is_ar %}الدعم{% else %}Support{% endif %}</h4>
      <ul>
        <li><a href="/pages/benefits">{% if is_ar %}المزايا{% else %}Benefits{% endif %}</a></li>
        <li><a href="/pages/contact">{% if is_ar %}اتصل بنا{% else %}Contact{% endif %}</a></li>
        <li><a href="/pages/faq">{% if is_ar %}الأسئلة الشائعة{% else %}FAQ{% endif %}</a></li>
        <li><a href="https://registry.brainsait.org" target="_blank" rel="noopener noreferrer">{% if is_ar %}السجل{% else %}Registry{% endif %} <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a></li>
      </ul>
    </div>

    <!-- Ecosystem Column -->
    <div class="brainsait-footer__col">
      <h4>{% if is_ar %}النظام الإيكولوجي{% else %}Ecosystem{% endif %}</h4>
      <ul>
        <li><a href="https://hub.brainsait.de" target="_blank" rel="noopener noreferrer">{% if is_ar %}الهوب{% else %}Hub{% endif %} <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a></li>
        <li><a href="https://registry.brainsait.org" target="_blank" rel="noopener noreferrer">BPR <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a></li>
        <li><a href="https://code.brainsait.org" target="_blank" rel="noopener noreferrer">Code Platform <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a></li>
        <li><a href="https://store.brainsait.de" target="_blank" rel="noopener noreferrer">{% if is_ar %}المتجر{% else %}Store{% endif %} <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a></li>
      </ul>
    </div>

  </div>

  <!-- Divider -->
  <div class="brainsait-footer__divider">
    <hr>
  </div>

  <!-- Bottom Bar -->
  <div class="brainsait-footer__bottom">
    <p class="brainsait-footer__copy">
      &copy; {% assign current_year = 'now' | date: '%Y' %}{{ current_year }}
      <a href="/">BrainSAIT</a>.
      {% if is_ar %}جميع الحقوق محفوظة.{% else %}All rights reserved.{% endif %}
    </p>
    <div class="brainsait-footer__ecosystem" aria-label="Ecosystem partners">
      <a href="https://github.com/brainsait" target="_blank" rel="noopener noreferrer" class="brainsait-footer__eco-link">GitHub <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a>
      <a href="https://n8n.brainsait.de" target="_blank" rel="noopener noreferrer" class="brainsait-footer__eco-link">n8n <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a>
      <a href="https://notion.brainsait.org" target="_blank" rel="noopener noreferrer" class="brainsait-footer__eco-link">Notion <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a>
      <a href="https://airtable.com/brainsait" target="_blank" rel="noopener noreferrer" class="brainsait-footer__eco-link">Airtable <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a>
      <a href="https://canvas.brainsait.org" target="_blank" rel="noopener noreferrer" class="brainsait-footer__eco-link">Canvas <span class="eco-arrow" aria-hidden="true">&#x2197;</span></a>
