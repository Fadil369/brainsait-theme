                    src="{{ product.featured_media | image_url: '400x400' }}"
                    alt="{{ product.featured_media.alt | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <img
                    src="{{ 'product-1-1' | asset_url | image_url: '400x400' }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
              <div class="bs-related-card-info">
                <div class="bs-related-card-title">{{ product.title | escape }}</div>
                <div class="bs-related-card-price">{{ product.price | money_with_currency }}</div>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div><!-- /container -->
</div>

<script>
  (function() {
    var section = document.getElementById('BsProductDetail-{{ section.id }}');
    if (!section) return;

    // ---- Language Toggle ----
    var langBtns = section.querySelectorAll('[data-lang-btn]');
    var currentLang = 'en';

    langBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var lang = this.getAttribute('data-lang-btn');
        if (lang === currentLang) return;
        currentLang = lang;

        langBtns.forEach(function(b) { b.classList.remove('active'); });
        this.classList.add('active');

        section.classList.remove('bs-product-detail--en', 'bs-product-detail--ar');
        section.classList.add('bs-product-detail--' + lang);

        // Update visible spans
        var spans = section.querySelectorAll('[class*="bs-visible-"]');
        spans.forEach(function(span) {
          span.classList.remove('bs-visible-en', 'bs-visible-ar');
          span.classList.add('bs-visible-' + lang);
        });
      });
    });

    // ---- Gallery Thumbnails ----
    var thumbs = section.querySelectorAll('.bs-gallery-thumbs img');
    var mainImg = document.getElementById('BsMainImage');
    if (thumbs.length > 0 && mainImg) {
      thumbs.forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          thumbs.forEach(function(t) { t.classList.remove('active'); });
          this.classList.add('active');

          var thumbSrc = this.src.replace(/\/200x200/, '/1000x1000').replace(/_200x200\./, '_1000x1000.');
          mainImg.src = thumbSrc;
          mainImg.alt = this.alt;
        });
      });
    }

    // ---- Quantity ----
    window.BsQtyChange = function(delta) {
      var input = document.getElementById('BsQtyInput');
      var field = document.getElementById('BsQtyField');
      if (!input || !field) return;
      var val = parseInt(input.value) || 1;
      val = Math.max(1, Math.min(99, val + delta));
      input.value = val;
      field.value = val;
    };

    document.getElementById('BsQtyInput') && document.getElementById('BsQtyInput').addEventListener('change', function() {
      var val = Math.max(1, Math.min(99, parseInt(this.value) || 1));
      this.value = val;
      var field = document.getElementById('BsQtyField');
      if (field) field.value = val;
    });

    // ---- Variant Selection ----
    window.BsUpdateVariant = function(btn) {
      var options = section.querySelectorAll('.bs-variant-option');
      options.forEach(function(o) { o.classList.remove('selected'); });
      btn.classList.add('selected');

      // Build variant form hidden input
      var form = document.getElementById('product-form-{{ section.id }}');
      if (form) {
        var variantInput = form.querySelector('input[name="id"]');
        // Find matching variant
        var optionValues = [];
        options.forEach(function(o) {
          if (o.classList.contains('selected')) {
            optionValues.push(o.getAttribute('data-value'));
          }
        });
        // Use Shopify's built-in variant selection
        if (variantInput && btn.getAttribute('data-variant-id')) {
          variantInput.value = btn.getAttribute('data-variant-id');
        }
      }
    };

    // ---- Price Update on Variant Change ----
    var priceEl = document.getElementById('BsPrice');
    var allOptionBtns = section.querySelectorAll('.bs-variant-option');
    allOptionBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        // Trigger native Shopify variant form submit for price update
        var form = document.getElementById('product-form-{{ section.id }}');
        if (form && this.getAttribute('data-variant-id')) {
          var hidden = form.querySelector('input[name="id"]');
          if (hidden) {
            hidden.value = this.getAttribute('data-variant-id');
            // Use native form action for proper price/variant update
            form.submit();
          }
        }
      });
    });

  })();
</script>

