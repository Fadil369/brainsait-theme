{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, SEO tags,
  and JSON-LD structured data for products and organization.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content="#080b12"
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_image = page_image

  if request.page_type == 'product'
    assign og_type = 'product'
    if product.images.size > 0
      assign og_image = product.images[0]
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
    if product.featured_image != blank
      assign og_image = product.featured_image
    endif
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<!-- Open Graph -->
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{% if og_image != blank %}
  <meta property="og:image" content="{{ og_image | image_url: width: 1200, height: 630, crop: 'center' | https }}">
  <meta property="og:image:secure_url" content="{{ og_image | image_url: width: 1200, height: 630, crop: 'center' | https }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/jpeg">
{% endif %}

{% if request.page_type == 'product' %}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{% endif %}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{% if og_image != blank %}
  <meta name="twitter:image" content="{{ og_image | image_url: width: 1200, height: 600, crop: 'center' | https }}">
{% endif %}

<!-- Schema.org JSON-LD -->
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }},
    {% if settings.logo %}
    "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_facebook_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_twitter_link | json }},
      {{ settings.social_youtube_link | json }}
    ] | compact | join: ","
  }
</script>

{% if request.page_type == 'product' and product.available %}
<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "image": [
      {% for image in product.images limit: 6 %}
        {{ image | image_url: width: 1000, height: 1000, crop: 'center' | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    "description": {{ product.description | strip_html | truncate: 200 | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ shop.name | json }}
    },
    "offers": {
      "@type": "Offer",
      "url": {{ request.origin | append: product.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ product.price | money_without_currency | replace: ',', '' | strip_html | json }},
      "priceValidUntil": "{{ '2026-12-31' | date: '%Y-%m-%d' }}",
      "availability": "http://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
      "seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
    }
  }
</script>
{% endif %}

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}