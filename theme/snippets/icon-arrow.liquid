{%- comment -%}
  Arrow icon (LTR/RTL aware) — right-pointing in LTR, left-pointing in RTL.
{%- endcomment -%}
{%- liquid
  assign is_rtl = false
  if request.locale.iso_code == 'ar' or settings.direction == 'rtl'
    assign is_rtl = true
  endif
-%}
<svg
  class="icon icon-arrow{% if is_rtl %} icon-arrow--rtl{% endif %}"
  xmlns="http://www.w3.org/2000/svg"
  width="16" height="16" viewBox="0 0 16 16"
  fill="none" stroke="currentColor" stroke-width="1.5"
  stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true"
  {%- if is_rtl %} style="transform: scaleX(-1);"{% endif -%}
>
  <path d="M2 8h12M10 3l5 5-5 5"/>
</svg>
