{% doc %}
  Renders a BrainSAIT luxury product card (gh design system).

  Accepts an optional `qv` flag to attach quick-view data attributes to the
  cover, and an optional `show_book` flag to render the "Book a session"
  CTA for solutions carrying a `custom.booking_url` metafield.

  @param {product} product - The product to render
  @param {boolean} [qv] - Whether to attach quick-view data attributes
  @param {boolean} [show_book] - Whether to show the booking CTA
  @param {string} [shelf] - Collection handle context for payment routing

  @example
  {% render 'gh-pcard', product: product, qv: true %}
{% enddoc %}

{% liquid
  assign sub = product.type | default: ''
  for tag in product.tags
    unless tag == 'brainsait-catalog' or tag == 'github-io' or tag == 'LEARN' or tag == 'SOLUTIONS' or tag contains 'source:'
      assign sub = tag
      break
    endunless
  endfor

  assign booking_url = product.metafields.custom.booking_url
  assign demo_url = product.metafields.custom.demo_url
  assign shelf_handle = shelf | default: ''
  assign learn_monthly_url = shop.url | append: '/products/learn-brainsait-digital-access'
  assign solution_monthly_url = shop.url | append: '/products/solutions-brainsait-super-partner-program'
  assign solution_ready_url = shop.url | append: '/collections/solutions-ready'
  assign primary_url = product.url
  assign secondary_url = product.url
  assign primary_label = ''
  assign secondary_label = ''
  assign has_secondary = true

    assign primary_label = 'Buy now'
    assign secondary_label = 'Learn more'

  assign is_learn_product = false
  if product.tags contains 'LEARN'
    assign is_learn_product = true
  endif
  if product.tags contains 'learn-book'
    assign is_learn_product = true
  endif

  assign is_solution_product = false
  if product.tags contains 'SOLUTIONS'
    assign is_solution_product = true
  endif
  if product.tags contains 'solutions-ready'
    assign is_solution_product = true
  endif

  if shelf_handle == 'learn' or shelf_handle == 'brainsait-learn'
    assign primary_url = learn_monthly_url
      assign primary_label = 'Pay 182 SAR/mo'
  elsif shelf_handle == 'solutions'
    assign primary_url = solution_monthly_url
    if product.tags contains 'solutions-ready'
      assign secondary_url = product.url
    else
      assign secondary_url = solution_ready_url
    endif
      assign primary_label = 'Monthly 1,999 SAR'
      assign secondary_label = 'Ready 24,000 SAR'
  elsif is_learn_product
    assign secondary_url = learn_monthly_url
      assign secondary_label = 'All books 182 SAR'
  elsif is_solution_product
    assign primary_url = solution_monthly_url
    assign secondary_url = solution_ready_url
      assign primary_label = 'Monthly 1,999 SAR'
      assign secondary_label = 'Ready 24,000 SAR'
  elsif show_book and booking_url != blank
    assign secondary_url = booking_url
      assign primary_label = 'Learn more'
      assign secondary_label = 'Book session'
  else
    assign has_secondary = false
  endif

  assign is_free = false
  if product.price == 0 or product.price == blank
    assign is_free = true
  endif

  assign desc_plain = product.description | strip_html
  assign desc_lines = desc_plain | split: "\n"
  assign tagline = desc_lines | first | strip | truncate: 110
  assign benefit = desc_lines[1] | strip | truncate: 90
  if benefit == blank
    assign benefit = desc_lines[0] | strip | truncate: 90
  endif

  # Plan label — align with the LEARN/BUILD/SOLUTIONS/BPR subscription model.
  assign plan_label = ''
  if product.tags contains 'solutions-ready' or product.tags contains 'SOLUTIONS READY' or product.tags contains 'one-time'
      assign plan_label = 'Pre-built · one-time'
  elsif product.handle == 'provider-registry' or product.tags contains 'BPR' or product.type == 'SaaS Membership'
      assign plan_label = 'Permanent · yr/mo'
  elsif product.tags contains 'SOLUTIONS' or product.tags contains 'BUILD' or product.tags contains 'LEARN' or product.tags contains 'subscription'
      assign plan_label = 'Monthly'
  endif

  assign is_bpr = false
  if product.handle == 'provider-registry' or product.type == 'SaaS Membership'
    assign is_bpr = true
  endif
%}

<article class="pcard" data-sub="{{ sub | escape }}">
  <div class="pcard-cover"
    {% if qv %}
      data-qv
      data-qv-img="{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 }}{% endif %}"
      data-qv-cat="{{ sub | escape }}"
      data-qv-title="{{ product.title | escape }}"
      data-qv-prop="{{ tagline | escape }}"
      data-qv-desc="{{ desc_plain | truncate: 220 | escape }}"
      data-qv-meta="{{ sub | escape }}"
      data-qv-price="{% if is_free %}Free{% else %}{{ product.price | money }}{% endif %}"
      data-qv-compare="{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money }}{% endif %}"
      data-qv-url="{{ primary_url }}"
      data-qv-cta="{{ primary_label | escape }}"
    {% endif %}
  >
    <a class="pcard-cover-link" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 600, format: 'webp' | image_tag: alt: product.title, loading: 'lazy', widths: '300,600,800', sizes: '(min-width: 1100px) 300px, (min-width: 750px) 50vw, 100vw', class: 'pcard-cover-img' }}
      {% else %}
        <span class="pcard-cover-fallback">{{ product.title | slice: 0 | upcase }}</span>
      {% endif %}
    </a>
    {% if is_free %}
      <span class="pcard-badge pcard-badge-free">FREE</span>
    {% else %}
      <span class="pcard-badge">DIGITAL</span>
    {% endif %}
    <span class="pcard-badge pcard-format">{{ sub | upcase }}</span>
  </div>

  <div class="pcard-body">
    <p class="pcard-eyebrow">{% if is_bpr %}◎ BPR · {% endif %}{{ sub }}</p>
    <h3 class="pcard-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% if is_bpr %}
      <p class="pcard-prop" style="color: var(--ink-soft); font-weight: 600;">Verified identity · SPID/OID · QR share · bilingual copilot</p>
    {% else %}
      <p class="pcard-prop">{{ tagline }}</p>
    {% endif %}
    {% unless benefit == blank %}
      <p class="pcard-benefit">{% if is_bpr %}— {% endif %}{{ benefit }}</p>
    {% endunless %}
    <div class="pcard-foot">
      {% if is_free %}
        <span class="pcard-price pcard-price-gold">
          Free
        </span>
      {% else %}
        <span class="pcard-price pcard-price-gold">{% if is_bpr %}3,960 / 163 SAR{% else %}{{ product.price | money }}{% endif %}{% if plan_label != '' %} <span class="pcard-plan" {% if is_bpr %}style="background:rgba(184,241,78,.18); color:#3a5a00; border:1px solid rgba(184,241,78,.35);"{% endif %}>{{ plan_label }}</span>{% endif %}</span>
      {% endif %}
      <div class="pcard-cta">
        {% if is_bpr %}
          <a class="button primary sm" href="{{ product.url }}" style="background: linear-gradient(135deg, #b8f14e, #8ec800); color:#111;">
            Annual 3,960
          </a>
          <a class="button secondary sm" href="{{ product.url }}?variant=monthly">
            Monthly 163
          </a>
        {% else %}
          <a class="button primary sm" href="{{ primary_url }}">
            {% if is_free %}
              Get
            {% else %}
              {{ primary_label }}
            {% endif %}
          </a>
          {% if has_secondary %}
            <a class="button secondary sm" href="{{ secondary_url }}"{% if secondary_url contains 'http' %} target="_blank" rel="noopener"{% endif %}>
              {{ secondary_label }}
            </a>
          {% endif %}
          {% if demo_url != blank %}
            <a class="button secondary sm" href="{{ demo_url }}" target="_blank" rel="noopener">
              Live demo
            </a>
          {% endif %}
        {% endif %}
        {% if qv %}
          <button class="button secondary sm pcard-qv" type="button" data-qv
            data-qv-img="{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 }}{% endif %}"
            data-qv-cat="{{ sub | escape }}"
            data-qv-title="{{ product.title | escape }}"
            data-qv-prop="{{ tagline | escape }}"
            data-qv-desc="{{ desc_plain | truncate: 220 | escape }}"
            data-qv-meta="{{ sub | escape }}"
            data-qv-price="{% if is_free %}Free{% else %}{{ product.price | money }}{% endif %}"
            data-qv-compare="{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money }}{% endif %}"
            data-qv-url="{{ primary_url }}"
            data-qv-cta="{{ primary_label | escape }}"
          >
            Quick view
          </button>
        {% endif %}
      </div>
    </div>
    {% render 'mf-pay-buttons', product: product, compact: true %}
  </div>
</article>
{% stylesheet %}
  .pcard-price-gold {
    font-weight: 800;
    background: linear-gradient(120deg, #f5dd9d, #e9c46a, #f0c96e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  [dir="rtl"] .pcard-price-gold { font-weight: 800; }
  .pcard-plan {
    display: inline-block;
    margin-left: 6px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #0a2540;
    background: #e8f0fb;
    padding: 2px 8px;
    border-radius: 999px;
    vertical-align: middle;
  }
  [dir="rtl"] .pcard-plan { margin-left: 0; margin-right: 6px; }
{% endstylesheet %}
