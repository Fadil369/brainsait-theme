{% doc %}
  Renders local Saudi payment-option quick-pay buttons (STC Pay · mada · Card)
  powered by MyFatoorah payment links.

  Each product carries a `custom.myfatoorah_payment_link` metafield — the hosted
  MyFatoorah checkout URL (one per amount / installment) generated by the
  `ExecutePayment` API. When a link is present this renders three buttons that
  open that checkout; when absent (or zero-priced / free) it renders nothing, so
  the UI never shows a broken payer path.

  @param {product} product - The product whose payment link + price is rendered
  @param {boolean} [compact] - Render as smaller inline chips for card grids

  @example
  {% render 'mf-pay-buttons', product: product, compact: true %}
{% enddoc %}

{% liquid
  assign paylink = product.metafields.custom.myfatoorah_payment_link
  if product.type == blank
    assign mf = false
  endif
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
  assign show = false
  if paylink != blank and product.price != blank and product.price > 0
    assign show = true
  endif
%}

{% if show %}
  <div class="mf-pay" data-mf-link="{{ paylink | escape }}">
    <p class="mf-pay-label">{% if is_ar %}ادفع عبر طرق الدفع المحلية{% else %}Pay via local methods{% endif %}</p>
    <div class="mf-pay-grid{% if compact == true %} mf-pay-grid--compact{% endif %}">
      <a class="mf-pay-btn mf-pay-stcpay" href="{{ paylink }}" target="_blank" rel="noopener">
        <span class="mf-pay-dot" aria-hidden="true"></span>
        <span>{% if is_ar %}STC Pay{% else %}STC Pay{% endif %}</span>
      </a>
      <a class="mf-pay-btn mf-pay-mada" href="{{ paylink }}" target="_blank" rel="noopener">
        <span class="mf-pay-dot" aria-hidden="true"></span>
        <span>mada</span>
      </a>
      <a class="mf-pay-btn mf-pay-card" href="{{ paylink }}" target="_blank" rel="noopener">
        <span class="mf-pay-dot" aria-hidden="true"></span>
        <span>{% if is_ar %}بطاقة{% else %}Card{% endif %}</span>
      </a>
    </div>
  </div>
{% endif %}
