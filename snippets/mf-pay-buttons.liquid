{% doc %}
  Renders local Saudi payment-option quick-pay buttons (STC Pay · mada · Card)
  backed by the myfatoorah-checkout Worker (`POST /create-payment-link`).

  Each click collects a guest email/phone, calls the Worker (which prices the
  variant server-side from the Shopify catalog, never trusting the client), and
  redirects to the hosted MyFatoorah checkout. Rules:

  - Only renders for priced products (price > 0), so free/`0 SAR` items
    (BUILD-CARE, free guided-builds) never show a payer path.
  - Skips SOLUTIONS that carry `custom.booking_url` (those use "Book a session").
  - Gated by the `mf_pay_enabled` setting: while the Worker is in MyFatoorah TEST
    mode (or the live key isn't confirmed), keep it OFF so a customer is never
    sent to a sandbox invoice.

  @param {product} product - The product to render payment buttons for
  @param {boolean} [compact] - Smaller inline chips for grid cards

  @example
  {% render 'mf-pay-buttons', product: product, compact: true %}
{% enddoc %}

{% liquid
  assign enabled = settings.mf_pay_enabled
  assign variant = product.selected_or_first_available_variant | default: product.variants.first
  assign booking_url = product.metafields.custom.booking_url
  assign show = false
  if enabled and variant and variant.price != blank and variant.price > 0 and booking_url == blank
    assign show = true
  endif
%}

{% if show %}
  <div class="mf-pay">
    <p class="mf-pay-label">
      Pay Saudi methods
    </p>
    <p class="mf-pay-hint">STC Pay · mada · Card via MyFatoorah</p>
    <div class="mf-pay-grid{% if compact == true %} mf-pay-grid--compact{% endif %}"
         data-mf-worker="{{ settings.mf_worker_url | default: '' | escape }}"
         data-mf-variant="{{ variant.id }}">
      <a class="mf-pay-btn mf-pay-stcpay" href="#" data-mf-variant="{{ variant.id }}" rel="noopener">
        <span class="mf-pay-dot" aria-hidden="true"></span><span>STC Pay</span>
      </a>
      <a class="mf-pay-btn mf-pay-mada" href="#" data-mf-variant="{{ variant.id }}" rel="noopener">
        <span class="mf-pay-dot" aria-hidden="true"></span><span>mada</span>
      </a>
      <a class="mf-pay-btn mf-pay-card" href="#" data-mf-variant="{{ variant.id }}" rel="noopener">
        <span class="mf-pay-dot" aria-hidden="true"></span>
        <span>Card</span>
      </a>
    </div>
  </div>
{% endif %}
