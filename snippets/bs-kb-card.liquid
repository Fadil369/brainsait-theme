{% doc %}
  Renders a single Knowledge Base card.
  @param {object} article
  @param {string} kicker_en
  @param {string} icon - report | article | podcast | video
{% enddoc %}

<a href="{{ article.url }}" class="bs-kb-card">
  {% if article.image %}
    <div class="bs-kb-card__media">
      <img
        src="{{ article.image | image_url: width: 600 }}"
        alt="{{ article.image.alt | escape }}"
        loading="lazy"
        width="600"
        height="338"
      >
    </div>
  {% else %}
    <div class="bs-kb-card__media bs-kb-card__media--icon bs-kb-card__media--{{ icon }}" aria-hidden="true">
      {% case icon %}
        {% when 'report' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M6 3h9l5 5v13H6z" />
            <path d="M15 3v5h5" />
            <path d="M9 12h6M9 16h6" />
          </svg>
        {% when 'article' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M4 19.5V6a2 2 0 0 1 2-2h13v15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" />
            <path d="M4 19.5A2 2 0 0 1 6 17.5h13" />
            <path d="M8 8h9M8 12h9" />
          </svg>
        {% when 'podcast' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="9" y="3" width="6" height="11" rx="3" />
            <path d="M5 11a7 7 0 0 0 14 0" />
            <path d="M12 18v3" />
          </svg>
        {% when 'video' %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="3" y="5" width="14" height="14" rx="2" />
            <path d="M17 9.5 21 7v10l-4-2.5" />
          </svg>
      {% endcase %}
    </div>
  {% endif %}
  <div class="bs-kb-card__body">
    <span class="bs-kb-card__kicker">
      {{ kicker_en }}
    </span>
    <h3 class="bs-kb-card__title">{{ article.title }}</h3>
    {% if article.excerpt != blank %}
      <p class="bs-kb-card__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
    {% endif %}
  </div>
</a>
