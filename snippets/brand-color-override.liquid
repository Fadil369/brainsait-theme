{% doc %}
  BrainSAIT brand color override for non-home templates.

  Applies the tokens from fadil369.github.io/src/styles/brand.css to every
  template EXCEPT the homepage (index). The homepage is intentionally
  left untouched — its color system is defined in templates/index.json and
  sections/gh-home.liquid.

  @usage Render after snippets/color-palette so these declarations win the cascade.
  @example
  {%- render 'brand-color-override' -%}
{% enddoc %}

{%- unless template == 'index' -%}
  {%- style -%}
    /* ============================================================
       BrainSAIT Brand Tokens (v2.1) — non-home templates only
       Source: fadil369.github.io/src/styles/brand.css
       ============================================================ */
    :root {
      /* Hex tokens */
      --midnight-blue: #1a365d;
      --medical-blue: #2b6cb8;
      --signal-teal: #0ea5e9;
      --deep-orange: #ea580c;
      --deep-orange-dark: #c2410c;
      --professional-gray: #64748b;
      --brand-text: #eef1fb;
      --brand-bg: #0a0e21;

      /* RGB triplets for rgba() usage */
      --midnight-blue-rgb: 26 54 93;
      --medical-blue-rgb: 43 108 184;
      --signal-teal-rgb: 14 165 233;
      --deep-orange-rgb: 234 88 12;
      --brand-text-rgb: 238 241 251;
      --brand-bg-rgb: 10 14 33;
    }

    /* Base page canvas on non-home templates */
    :root {
      --color-background: var(--brand-bg);
      --color-background-rgb: var(--brand-bg-rgb);
      --color-foreground: var(--brand-text);
      --color-foreground-rgb: var(--brand-text-rgb);
      --color-border: var(--brand-text);
      --color-border-rgb: var(--brand-text-rgb);
      --color-foreground-muted: rgb(var(--brand-text-rgb) / 0.6);
      --color-foreground-subdued: rgb(var(--brand-text-rgb) / 0.8);
    }

    body {
      background-color: var(--color-background);
      color: var(--color-foreground);
    }

    /* Header: force underlay rows to use the branded background so the
       literal page_background_color value does not overrule our variables. */
    #header-component .header__underlay-closed,
    #header-component .header__underlay-open {
      --color-background-top-row: var(--color-background);
      --color-background-bottom-row: var(--color-background);
    }

    #header-component .header__row {
      --color-foreground: var(--brand-text);
      --color-foreground-rgb: var(--brand-text-rgb);
    }

    /* Primary buttons: deep orange with smart hover */
    :root {
      --color-primary-button-text: rgb(255 255 255);
      --color-primary-button-background: var(--deep-orange);
      --color-primary-button-border: var(--deep-orange);
      --color-primary-button-focus-outline: var(--deep-orange);
      --color-primary-button-hover-text: rgb(255 255 255);
      --color-primary-button-hover-background: var(--deep-orange-dark);
      --color-primary-button-hover-border: var(--deep-orange-dark);
    }

    /* Secondary / outline buttons: signal teal */
    :root {
      --color-secondary-button-text: var(--signal-teal);
      --color-secondary-button-background: transparent;
      --color-secondary-button-border: var(--signal-teal);
      --color-secondary-button-hover-text: var(--brand-bg);
      --color-secondary-button-hover-background: var(--signal-teal);
      --color-secondary-button-hover-border: var(--signal-teal);
    }

    /* Glass-morphism panels using the brand midnight-blue token */
    .panel {
      background: rgb(var(--midnight-blue-rgb) / 0.4);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      border: 1px solid rgb(255 255 255 / 0.2);
      border-radius: 16px;
      box-shadow: 0 4px 12px rgb(0 0 0 / 0.2);
    }

    .panel > *,
    .panel .text-block {
      color: var(--brand-text);
    }

    /* Mesh-gradient hero fallback using brand colors */
    .hero {
      background:
        radial-gradient(circle at 30% 20%, #0b0d20, var(--midnight-blue) 50%),
        radial-gradient(circle at 70% 80%, var(--medical-blue), var(--signal-teal) 50%);
      background-blend-mode: screen;
      color: var(--brand-text);
    }

    /* Respect reduced-motion users while keeping brand colors */
    @media (prefers-reduced-motion: reduce) {
      .panel,
      .hero,
      .button,
      .button-secondary,
      .button-custom {
        animation: none !important;
        transition: none !important;
      }

      .hero {
        background: var(--midnight-blue);
      }
    }
  {%- endstyle -%}
{%- endunless -%}
