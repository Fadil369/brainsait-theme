{%- liquid
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
  assign build_monthly = all_products['build-forge-incubator-founders-program']
  assign build_ticket = all_products['build-ticket']
  assign learn_url = shop.url | append: '/collections/learn'
-%}
{% # theme-check-disable ValidScopedCSSClass %}

<div class="page build-page bs-build" data-component="gh-build">
  <section class="bs-build__hero">
    <p class="bs-build__eyebrow"><span class="dot"></span> {% if is_ar %}برنامج الاحتضان — فورج{% else %}The Forge Incubation Program{% endif %}</p>
    <h1 class="bs-build__heading">{% if is_ar %}ابنِ منتجاً حقيقياً في <span class="gold">16 يوماً</span>{% else %}Build a real product in <span class="gold">16 days</span>{% endif %}</h1>
    <p class="bs-build__lede">
      {% if is_ar %}
        اشترك شهرياً أو ادفع تذكرة واحدة — احصل على وصول كامل لـ LEARN + دورات فورج + عقلك الثاني + تتبع عبر بوت تليجرام، مع إيميل شكراً وترحيب وربط تلقائي بالاستحقاقات.
      {% else %}
        Subscribe monthly or pay a one-time ticket — get full LEARN access + Forge courses + your 2nd Brain + Telegram bot tracking, with thank-you/welcome email automation and entitlement routing.
      {% endif %}
    </p>
  </section>

  <section class="bs-build__plans">
    <div class="bs-build__plan bs-build__plan--featured">
      <span class="bs-build__badge">{% if is_ar %}الأكثر طلباً · متجدد{% else %}Most popular · Recurring{% endif %}</span>
      <h3>{% if is_ar %}BUILD شهري{% else %}BUILD Monthly{% endif %}</h3>
      <p class="bs-build__price">499 {% if is_ar %}ر.س{% else %}SAR{% endif %} <small>{% if is_ar %}/ شهر{% else %}/mo{% endif %}</small></p>
      <p class="bs-build__tagline">{% if is_ar %}دخول فورج لمدة 30 يوماً يتجدد تلقائياً، مع Notion و2nd Brain وTelegram{% else %}30-day Forge access, renews automatically, with Notion, 2nd Brain, and Telegram{% endif %}</p>
      <ul class="bs-build__list">
        <li>📚 {% if is_ar %}كل كتب LEARN{% else %}All LEARN books{% endif %}</li>
        <li>🧠 {% if is_ar %}دورات فورج في Notion{% else %}Forge courses on Notion{% endif %}</li>
        <li>🗂️ {% if is_ar %}العقل الثاني{% else %}2nd Brain{% endif %}</li>
        <li>✈️ {% if is_ar %}تتبع بوت تليجرام{% else %}Telegram bot tracking{% endif %}</li>
      </ul>
      <a class="button bs-build__cta" href="{{ build_monthly.url | default: '/products/build-forge-incubator-founders-program' }}">
        {% if is_ar %}اشترك شهرياً{% else %}Subscribe monthly{% endif %} →
      </a>
    </div>

    <div class="bs-build__plan">
      <h3>{% if is_ar %}تذكرة BUILD{% else %}BUILD Ticket{% endif %}</h3>
      <p class="bs-build__price">9,630 {% if is_ar %}ر.س{% else %}SAR{% endif %} <small>{% if is_ar %}لمرة واحدة{% else %}one-time{% endif %}</small></p>
      <p class="bs-build__tagline">{% if is_ar %}نفس وصول فورج، بدفعة واحدة، مع تسليم بعد الشراء{% else %}The same Forge access, one payment, with post-purchase delivery{% endif %}</p>
      <ul class="bs-build__list">
        <li>📚 {% if is_ar %}كل كتب LEARN{% else %}All LEARN books{% endif %}</li>
        <li>🧠 {% if is_ar %}دورات فورج في Notion{% else %}Forge courses on Notion{% endif %}</li>
        <li>🗂️ {% if is_ar %}العقل الثاني{% else %}2nd Brain{% endif %}</li>
        <li>✈️ {% if is_ar %}تتبع بوت تليجرام{% else %}Telegram bot tracking{% endif %}</li>
      </ul>
      <a class="button bs-build__cta" href="{{ build_ticket.url | default: '/products/build-ticket' }}">
        {% if is_ar %}اشترِ التذكرة{% else %}Buy the ticket{% endif %} →
      </a>
    </div>
  </section>

  <section class="bs-build__sprint">
    <h2>{% if is_ar %}سباق البناء — 16 يوماً{% else %}Your build sprint — 16 days{% endif %}</h2>
    <div class="bs-build__track">
      <div class="bs-build__phase"><span class="bs-build__flag">{% if is_ar %}الأسبوع 1{% else %}Week 1{% endif %}</span><h3>{% if is_ar %}البناء والإطلاق{% else %}Build &amp; Launch{% endif %}</h3><p>{% if is_ar %}رحلة فورج من الفكرة إلى إطلاق المنتج.{% else %}The Forge journey — idea to shipped product.{% endif %}</p></div>
      <div class="bs-build__phase"><span class="bs-build__flag">{% if is_ar %}الأسبوع 2{% else %}Week 2{% endif %}</span><h3>{% if is_ar %}التسويق والتسليم{% else %}Marketing &amp; Delivery{% endif %}</h3><p>{% if is_ar %}خطة تسويق وإطلاق القنوات وتسليم المشروع.{% else %}Marketing plan, channel launch, and delivery.{% endif %}</p></div>
      <div class="bs-build__phase"><span class="bs-build__flag">{% if is_ar %}التخرج{% else %}Graduation{% endif %}</span><h3>{% if is_ar %}شهادة الإتمام{% else %}Completion certificate{% endif %}</h3><p>{% if is_ar %}شهادة دائمة عند إتمام المعالم الـ16.{% else %}A permanent certificate once all 16 milestones are complete.{% endif %}</p></div>
    </div>
  </section>

  <section class="bs-build__brain">
    <h2>🧠 {% if is_ar %}عقلك الثاني — هدية كل بنّاء{% else %}Your Second Brain — every builder's gift{% endif %}</h2>
    <p>
      {% if is_ar %}
        حسابك الدائم، مستودع GitHub الخاص بك، دورات فورج المنظمة في Notion، وتتبع التقدم عبر بوت تليجرام — كلها تبقى معك.
      {% else %}
        Your permanent account, your own GitHub repo, Forge courses organized in Notion, and progress tracking via the Telegram bot — all stay with you.
      {% endif %}
    </p>
  </section>

  <section class="bs-build__trust">
    <h2>{% if is_ar %}الأمان والسياسات{% else %}Security &amp; Policy{% endif %}</h2>
      <p>🛡️ {% if is_ar %}دفع سعودي آمن (STC Pay · mada · بطاقة) · متوافق مع PDPL · تسليم رقمي فوري · تحديثات حالة تلقائية{% else %}Secure Saudi pay (STC Pay · mada · Card) · PDPL-aligned · instant digital delivery · automatic status updates{% endif %}</p>
  </section>
</div>

{% style %}
  .bs-build { padding: 3rem 0; }
  .bs-build__hero { text-align: center; max-width: 760px; margin: 0 auto 2.5rem; }
  .bs-build__eyebrow { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; opacity: .8; margin-bottom: .8rem; }
  .bs-build__heading { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0 0 .8rem; }
  .bs-build__heading .gold { background: linear-gradient(120deg, var(--gold-2,#f5dd9d), var(--gold,#e9c46a)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .bs-build__lede { font-size: 1.05rem; line-height: 1.7; opacity: .85; }
  .bs-build__plans { display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; max-width: 760px; margin: 0 auto 3rem; }
  .bs-build__plan { position: relative; border: 1px solid rgb(var(--color-border-rgb,0 0 0)/.14); border-radius: 18px; padding: 1.6rem; display: flex; flex-direction: column; background: rgb(var(--color-background-rgb,255 255 255)/.7); backdrop-filter: blur(14px); }
  .bs-build__plan--featured { border-color: var(--gold,#e9c46a); box-shadow: 0 12px 36px rgb(0 0 0/.12); }
  .bs-build__badge { position: absolute; inset-inline-end: 12px; top: 12px; background: var(--gold,#e9c46a); color: #111; font-size: 11px; font-weight: 800; padding: 3px 9px; border-radius: 999px; }
  .bs-build__price { font-size: 2rem; font-weight: 800; margin: .4rem 0; }
  .bs-build__price small { font-size: .9rem; opacity: .7; font-weight: 600; }
  .bs-build__tagline { font-size: .9rem; opacity: .75; margin-bottom: .8rem; }
  .bs-build__list { list-style: none; margin: 0 0 1.2rem; padding: 0; display: flex; flex-direction: column; gap: .55rem; font-size: .92rem; }
  .bs-build__cta { display: inline-flex; justify-content: center; width: 100%; }
  .bs-build__sprint, .bs-build__brain, .bs-build__trust { max-width: 900px; margin: 0 auto 2.5rem; }
  .bs-build__track { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
  .bs-build__phase { border: 1px solid rgb(var(--color-border-rgb,0 0 0)/.12); border-radius: 14px; padding: 1.2rem; }
  .bs-build__flag { display: inline-block; font-size: 11px; letter-spacing: .06em; text-transform: uppercase; opacity: .7; margin-bottom: .4rem; }
  .bs-build__phase h3 { margin: 0 0 .4rem; }
  .bs-build__phase p { font-size: .9rem; opacity: .8; margin: 0; }
  @media (max-width: 749px) { .bs-build__plans { grid-template-columns: 1fr; } .bs-build__track { grid-template-columns: 1fr; } }
{% endstyle %}

{% schema %}
{
  "name": "BUILD (GH)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" }
  ],
  "presets": [{ "name": "BUILD (GH)" }]
}
{% endschema %}
