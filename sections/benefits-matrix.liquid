{% comment %}
  Benefits Matrix — LEARN · BUILD · SOLUTION (bilingual, synced to store.brainsait.de)
  Add to any page via the theme editor. Renders 6 tiers as 3 groups with 2 price options each.
  Source of truth: handles/prices match live Shopify products (see AGENTS.md §21).
{% endcomment %}

{% liquid
%}

<section class="benefits-matrix color-{{ section.settings.color_scheme }} gradient" style="padding: 3rem 0;">
  <div class="page-width">
    <div class="benefits-matrix__head" style="text-align:center; max-width:760px; margin:0 auto 1.6rem;">
      <p class="benefits-matrix__eyebrow" style="display:inline-flex; align-items:center; gap:6px; font-size:11px; letter-spacing:.08em; text-transform:uppercase; opacity:.7;">✨ Choose your path</p>
      <h2 style="font-size:1.8rem; margin:.4rem 0;">Benefits matrix — LEARN · BUILD · SOLUTION</h2>
      <p style="opacity:.7; font-size:14px;">Each path builds on the last. LEARN opens 40 learning cards, BUILD turns them into an applied program, and SOLUTION ships them as a deliverable service that can scale.</p>
    </div>

    {% style %}
      .benefits-matrix__grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(280px,1fr)); gap:1rem; align-items:stretch; }
      .benefits-matrix__group { display:flex; flex-direction:column; gap:.9rem; }
      .benefits-matrix__cat { display:flex; align-items:center; gap:8px; border-inline-start:4px solid var(--cat); padding-inline-start:10px; font-weight:800; letter-spacing:.06em; font-size:12px; }
      .benefits-card { border:1px solid rgba(0,0,0,.08); border-radius:14px; background:#fff; overflow:hidden; position:relative; }
      .benefits-card--popular { border-color:#f59e0b; box-shadow: 0 6px 24px rgba(245,158,11,.18); }
      .benefits-card__badge { position:absolute; inset-inline-end:12px; top:10px; background:#f59e0b; color:#111; font-size:11px; font-weight:800; padding:3px 8px; border-radius:999px; }
      .benefits-card__body { padding:1rem; }
      .benefits-card__price { font-size:1.35rem; font-weight:800; }
      .benefits-card__list { list-style:none; padding:0; margin:.6rem 0 0; display:flex; flex-direction:column; gap:6px; }
      .benefits-card__list li { display:flex; gap:8px; align-items:flex-start; font-size:13px; line-height:1.4; }
      .benefits-card__list li i { color:#10b981; font-style:normal; }
    {% endstyle %}

    <div class="benefits-matrix__grid">
      {% comment %} LEARN {% endcomment %}
      <div class="benefits-matrix__group">
        <div class="benefits-matrix__cat" style="--cat:#0ea5e9;">LEARN</div>
        <div class="benefits-card">
          <div class="benefits-card__body">
            <h3 style="margin:0;">LEARN Book</h3>
            <p style="opacity:.6; font-size:13px; margin:.2rem 0 .6rem;">One book, instant R2 download with direct detail page access</p>
            <div style="display:flex; align-items:baseline; gap:6px;"><span class="benefits-card__price">99 SAR</span><span style="opacity:.6; font-size:12px;">one-time</span></div>
            <ul class="benefits-card__list">
              <li><i>✓</i><span>📖 Single book PDF (R2)</span></li>
            </ul>
            <a class="button button--primary" href="https://store.brainsait.de/products/learn-brainsait-digital-access" style="width:100%; justify-content:center; margin-top:12px; display:flex;">Pay 182 SAR/mo</a>
            <a class="button button--secondary" href="https://store.brainsait.de/collections/learn-books" style="width:100%; justify-content:center; margin-top:10px; display:flex;">Browse books</a>
          </div>
        </div>
        <div class="benefits-card">
          <div class="benefits-card__body">
            <h3 style="margin:0;">LEARN Monthly</h3>
            <p style="opacity:.6; font-size:13px; margin:.2rem 0 .6rem;">All 40 books online, with payment reminders</p>
            <div style="display:flex; align-items:baseline; gap:6px;"><span class="benefits-card__price">182 SAR</span><span style="opacity:.6; font-size:12px;">/ mo</span></div>
            <ul class="benefits-card__list"><li><i>✓</i><span>📚 All 40 LEARN books</span></li></ul>
            <a class="button button--primary" href="https://store.brainsait.de/products/learn-brainsait-digital-access" style="width:100%; justify-content:center; margin-top:12px; display:flex;">Subscribe now</a>
            <a class="button button--secondary" href="https://store.brainsait.de/collections/learn-books" style="width:100%; justify-content:center; margin-top:10px; display:flex;">Learn more</a>
          </div>
        </div>
      </div>

      {% comment %} BUILD {% endcomment %}
      <div class="benefits-matrix__group">
        <div class="benefits-matrix__cat" style="--cat:#f59e0b;">BUILD</div>
        <div class="benefits-card benefits-card--popular">
          <span class="benefits-card__badge">Most popular</span>
          <div class="benefits-card__body">
            <h3 style="margin:0;">BUILD Monthly</h3>
            <p style="opacity:.6; font-size:13px; margin:.2rem 0 .6rem;">Forge incubator — 30 days, with Notion, 2nd Brain, and Telegram bot</p>
            <div style="display:flex; align-items:baseline; gap:6px;"><span class="benefits-card__price">499 SAR</span><span style="opacity:.6; font-size:12px;">/ mo</span></div>
            <ul class="benefits-card__list">
              <li><i>✓</i><span>📚 All LEARN books</span></li>
              <li><i>✓</i><span>🧠 Notion Forge</span></li>
              <li><i>✓</i><span>🗂️ 2nd Brain</span></li>
              <li><i>✓</i><span>✈️ Telegram bot</span></li>
            </ul>
            <a class="button button--primary" href="https://store.brainsait.de/products/build-forge-incubator-founders-program" style="width:100%; justify-content:center; margin-top:12px; display:flex;">Subscribe now</a>
            <a class="button button--secondary" href="https://store.brainsait.de/products/build-ticket" style="width:100%; justify-content:center; margin-top:10px; display:flex;">9,630 SAR ticket</a>
          </div>
        </div>
        <div class="benefits-card">
          <div class="benefits-card__body">
            <h3 style="margin:0;">BUILD Ticket</h3>
            <p style="opacity:.6; font-size:13px; margin:.2rem 0 .6rem;">One-time ticket</p>
            <div style="display:flex; align-items:baseline; gap:6px;"><span class="benefits-card__price">9,630 SAR</span><span style="opacity:.6; font-size:12px;">one-time</span></div>
            <ul class="benefits-card__list">
              <li><i>✓</i><span>📚 All LEARN books</span></li>
              <li><i>✓</i><span>🧠 Notion Forge</span></li>
              <li><i>✓</i><span>🗂️ 2nd Brain</span></li>
              <li><i>✓</i><span>✈️ Telegram</span></li>
            </ul>
            <a class="button button--secondary" href="https://store.brainsait.de/products/build-ticket" style="width:100%; justify-content:center; margin-top:12px; display:flex;">Buy now</a>
          </div>
        </div>
      </div>

      {% comment %} SOLUTION {% endcomment %}
      <div class="benefits-matrix__group">
        <div class="benefits-matrix__cat" style="--cat:#10b981;">SOLUTION</div>
        <div class="benefits-card">
          <div class="benefits-card__body">
            <h3 style="margin:0;">SOLUTION Ready</h3>
            <p style="opacity:.6; font-size:13px; margin:.2rem 0 .6rem;">Pre-built, deployed to you, with kickoff session and infra form</p>
            <div style="display:flex; align-items:baseline; gap:6px;"><span class="benefits-card__price">24,000 SAR</span><span style="opacity:.6; font-size:12px;">one-time</span></div>
            <ul class="benefits-card__list">
              <li><i>✓</i><span>📚 LEARN</span></li>
              <li><i>✓</i><span>🧠 Notion + 🗂️ 2nd Brain + ✈️ Telegram</span></li>
              <li><i>✓</i><span>💬 Lark super-partner</span></li>
              <li><i>✓</i><span>📅 Kickoff Meet</span></li>
              <li><i>✓</i><span>🚀 Pre-built deployment</span></li>
            </ul>
            <a class="button button--primary" href="https://store.brainsait.de/collections/solutions-ready" style="width:100%; justify-content:center; margin-top:12px; display:flex;">Choose your solution</a>
            <a class="button button--secondary" href="https://store.brainsait.de/products/solutions-brainsait-super-partner-program" style="width:100%; justify-content:center; margin-top:10px; display:flex;">1,999 SAR/mo</a>
          </div>
        </div>
        <div class="benefits-card">
          <div class="benefits-card__body">
            <h3 style="margin:0;">SOLUTION Monthly</h3>
            <p style="opacity:.6; font-size:13px; margin:.2rem 0 .6rem;">Super-partner, monthly, with Lark, Calendar, and Form</p>
            <div style="display:flex; align-items:baseline; gap:6px;"><span class="benefits-card__price">1,999 SAR</span><span style="opacity:.6; font-size:12px;">/ mo</span></div>
            <ul class="benefits-card__list">
              <li><i>✓</i><span>📚 LEARN</span></li>
              <li><i>✓</i><span>🧠 Notion + 🗂️ 2nd Brain + ✈️ Telegram</span></li>
              <li><i>✓</i><span>💬 Lark super-partner</span></li>
            </ul>
            <a class="button button--primary" href="https://store.brainsait.de/products/solutions-brainsait-super-partner-program" style="width:100%; justify-content:center; margin-top:12px; display:flex;">Subscribe now</a>
            <a class="button button--secondary" href="https://store.brainsait.de/collections/solutions-ready" style="width:100%; justify-content:center; margin-top:10px; display:flex;">Learn more</a>
          </div>
        </div>
        <div class="benefits-card benefits-card--popular" style="border-color:#b8f14e;">
          <span class="benefits-card__badge" style="background:#b8f14e; color:#111;">Provider identity</span>
          <div class="benefits-card__body">
            <h3 style="margin:0;">BrainSAIT Provider Registry</h3>
            <p style="opacity:.6; font-size:13px; margin:.2rem 0 .6rem;">SPID + OID + QR + verified profile — annual default, junior monthly</p>
            <div style="display:flex; align-items:baseline; gap:6px;"><span class="benefits-card__price">3,960 SAR</span><span style="opacity:.6; font-size:12px;">year</span><span style="opacity:.5; font-size:11px;">· 163 mo</span></div>
            <ul class="benefits-card__list">
              <li><i>✓</i><span>◎ Permanent BPR identity (SPID + OID · IANA 61026)</span></li>
              <li><i>✓</i><span>📚 LEARN + BUILD + SOLUTION access</span></li>
              <li><i>✓</i><span>🩺 Free multilingual clinical copilot</span></li>
            </ul>
            <a class="button button--primary" href="https://store.brainsait.de/products/provider-registry" style="width:100%; justify-content:center; margin-top:12px; display:flex;">Start annual</a>
          </div>
        </div>
      </div>
    </div>

    <p style="text-align:center; opacity:.6; font-size:12px; margin-top:1rem;">Prices in SAR · Checkout on store.brainsait.de · after purchase: thank-you + welcome + entitlement links</p>
  </div>
</section>

{% schema %}
{
  "name": "Benefits matrix",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1" }
  ],
  "presets": [{ "name": "Benefits matrix" }]
}
{% endschema %}
