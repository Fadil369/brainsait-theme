{% liquid
%}
{% # theme-check-disable ValidScopedCSSClass %}

<div class="bs-compliance">
  <div class="bs-compliance__inner page-width">
    <ul class="bs-compliance__list" role="list" aria-label="Compliance certifications">
      <li class="bs-compliance__pill">
        <span class="bs-compliance__icon" aria-hidden="true">⚕</span>
        <span class="bs-compliance__label">
          NPHIES v3.2
        </span>
      </li>
      <li class="bs-compliance__pill">
        <span class="bs-compliance__icon" aria-hidden="true">🔗</span>
        <span class="bs-compliance__label">
          FHIR R4
        </span>
      </li>
      <li class="bs-compliance__pill">
        <span class="bs-compliance__icon" aria-hidden="true">🔢</span>
        <span class="bs-compliance__label">
          IANA PEN 61026
        </span>
      </li>
      <li class="bs-compliance__pill">
        <span class="bs-compliance__icon" aria-hidden="true">🛡</span>
        <span class="bs-compliance__label">
          HIPAA/PDPL-aligned
        </span>
      </li>
      <li class="bs-compliance__pill">
        <span class="bs-compliance__icon" aria-hidden="true">☁</span>
        <span class="bs-compliance__label">Cloudflare</span>
      </li>
      <li class="bs-compliance__pill">
        <span class="bs-compliance__icon" aria-hidden="true">🇸🇦</span>
        <span class="bs-compliance__label">
          Vision 2030
        </span>
      </li>
    </ul>
  </div>
</div>

{% stylesheet %}
  .bs-compliance {
    background-color: var(--bs-surface, #0d0d1a);
    border-block-end: 1px solid var(--bs-border, #2a2a3e);
    padding-block: 0.9rem;
  }

  .bs-compliance__inner {
    display: flex;
    justify-content: center;
  }

  .bs-compliance__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bs-compliance__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.75rem;
    padding-block: 0.3rem;
    border-radius: 999px;
    border: 1px solid rgba(124, 111, 255, 0.35);
    background-color: rgba(124, 111, 255, 0.08);
    color: rgba(240, 240, 255, 0.82);
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .bs-compliance__pill:hover {
    border-color: rgba(124, 111, 255, 0.65);
    background-color: rgba(124, 111, 255, 0.16);
  }

  .bs-compliance__icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .bs-compliance__pill {
      font-size: 0.73rem;
      padding-inline: 0.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BS Compliance Strip",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "BS Compliance Strip"
    }
  ]
}
{% endschema %}
