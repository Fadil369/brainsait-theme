{% liquid
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
%}
{% # theme-check-disable ValidScopedCSSClass %}
{% if product.type == 'SOLUTIONS' or product.tags contains 'SOLUTIONS' %}
  <div class="gh-book__frame">
    <h2 class="gh-book__title">{% if is_ar %}احجز جلسة تعارف{% else %}Book a session{% endif %}</h2>
    <p class="gh-book__note">{% if is_ar %}احجز جلسة استشارية مجانية للبدء مع {{ product.title }}.{% else %}Book a free consultation session to get started with {{ product.title }}.{% endif %}</p>
    <iframe
      class="gh-book__iframe"
      src="{{ section.settings.booking_url }}"
      width="100%"
      height="600"
      style="border:0"
      loading="lazy"
      title="{% if is_ar %}حجز جلسة{% else %}Book a session{% endif %}"
    ></iframe>
  </div>
{% endif %}

{% stylesheet %}
  .gh-book__frame {
    max-width: var(--page-width, 1200px);
    margin: 40px auto;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-1);
  }
  .gh-book__title { margin: 0 0 8px; font-size: 1.3rem; }
  .gh-book__note { color: var(--muted); margin: 0 0 16px; }
  .gh-book__iframe { border-radius: var(--radius-m); background: #fff; }
{% endstylesheet %}

{% schema %}
{
  "name": "BS Book Session",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "booking_url",
      "label": "Booking calendar URL",
      "info": "Google Calendar appointment link shown on SOLUTIONS product pages",
      "default": "https://calendar.app.google/Ve9KSKmaVA6ehDP48"
    }
  ]
}
{% endschema %}
