{% liquid
%}
{% # theme-check-disable ValidScopedCSSClass %}

<div class="bs-testimonials">
  <div class="bs-testimonials__inner page-width">
    <h2 class="bs-testimonials__heading">
      
        What Our Clients Say
      
    </h2>

    <div class="bs-testimonials__grid">

      <article class="bs-testimonial" aria-label="Client testimonial">
        <div class="bs-testimonial__body">
          <span class="bs-testimonial__quote-mark" aria-hidden="true">"</span>
          <blockquote class="bs-testimonial__text">
            
              BrainSAIT's products transformed how we manage patient identity. The instant delivery and comprehensive documentation saved us weeks of development work.
            
          </blockquote>
        </div>
        <footer class="bs-testimonial__footer">
          <div class="bs-testimonial__avatar" aria-hidden="true">M</div>
          <div class="bs-testimonial__meta">
            <span class="bs-testimonial__name">
              Operations Director
            </span>
            <span class="bs-testimonial__role">
              King Fahd Medical City, Riyadh
            </span>
          </div>
        </footer>
      </article>

      <article class="bs-testimonial" aria-label="Client testimonial">
        <div class="bs-testimonial__body">
          <span class="bs-testimonial__quote-mark" aria-hidden="true">"</span>
          <blockquote class="bs-testimonial__text">
            
              The OID registry and FHIR bundles were exactly what we needed for NPHIES compliance. The bilingual support makes adoption seamless across our team.
            
          </blockquote>
        </div>
        <footer class="bs-testimonial__footer">
          <div class="bs-testimonial__avatar" aria-hidden="true">A</div>
          <div class="bs-testimonial__meta">
            <span class="bs-testimonial__name">
              IT Manager
            </span>
            <span class="bs-testimonial__role">
              Al-Mouwasat Group, Jeddah
            </span>
          </div>
        </footer>
      </article>

      <article class="bs-testimonial" aria-label="Client testimonial">
        <div class="bs-testimonial__body">
          <span class="bs-testimonial__quote-mark" aria-hidden="true">"</span>
          <blockquote class="bs-testimonial__text">
            
              Since adopting the Healthcare AI Identity Suite, our revenue cycle has accelerated noticeably. This solution is truly built for the Saudi market.
            
          </blockquote>
        </div>
        <footer class="bs-testimonial__footer">
          <div class="bs-testimonial__avatar" aria-hidden="true">S</div>
          <div class="bs-testimonial__meta">
            <span class="bs-testimonial__name">
              RCM Lead
            </span>
            <span class="bs-testimonial__role">
              Regional Medical Center, Dammam
            </span>
          </div>
        </footer>
      </article>

    </div>
  </div>
</div>

{% stylesheet %}
  .bs-testimonials {
    padding-block: 4rem 4.5rem;
    background-color: var(--color-background, #0a0a0f);
  }

  .bs-testimonials__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .bs-testimonials__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    color: var(--color-foreground, #f0f0ff);
    text-align: center;
    text-wrap: balance;
  }

  .bs-testimonials__grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media screen and (min-width: 750px) {
    .bs-testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bs-testimonial {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.75rem;
    border-radius: 12px;
    border: 1px solid var(--bs-border, #2a2a3e);
    background-color: var(--bs-surface, #0d0d1a);
    transition: border-color 0.2s ease;
  }

  .bs-testimonial:hover {
    border-color: rgba(124, 111, 255, 0.4);
  }

  .bs-testimonial__body {
    position: relative;
    flex: 1;
  }

  .bs-testimonial__quote-mark {
    position: absolute;
    top: -0.5rem;
    inset-inline-start: -0.25rem;
    font-size: 3.5rem;
    line-height: 1;
    font-family: Georgia, serif;
    color: var(--bs-accent, #7c6fff);
    opacity: 0.4;
    pointer-events: none;
    user-select: none;
  }

  .bs-testimonial__text {
    margin: 0;
    padding-block-start: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(240, 240, 255, 0.85);
    font-style: normal;
  }

  .bs-testimonial__footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--bs-border, #2a2a3e);
  }

  .bs-testimonial__avatar {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c6fff, #22d3ee);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family);
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
  }

  .bs-testimonial__meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .bs-testimonial__name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-foreground, #f0f0ff);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bs-testimonial__role {
    font-size: 0.8rem;
    color: var(--bs-muted, rgba(240,240,255,0.55));
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "BrainSAIT Testimonials",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "BrainSAIT Testimonials"
    }
  ]
}
{% endschema %}
