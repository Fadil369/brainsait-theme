{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrainSAIT canonical Shopify catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "sourceProductId",
      "title",
      "handle",
      "productType",
      "family",
      "vendor",
      "variants",
      "tags",
      "imageAspectRatio",
      "templateSuffix",
      "customerCopy"
    ],
    "properties": {
      "sourceProductId": { "type": ["string", "null"] },
      "title": { "type": "string", "minLength": 1 },
      "handle": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "productType": {
        "enum": [
          "LEARN Item",
          "LEARN Membership",
          "BUILD Membership",
          "SOLUTIONS Membership",
          "SOLUTIONS READY",
          "OID & Registry"
        ]
      },
      "family": { "enum": ["LEARN", "BUILD", "SOLUTIONS", "SOLUTIONS READY", "OID & REGISTRY"] },
      "vendor": { "const": "BrainSAIT" },
      "imageAspectRatio": { "const": "3:2" },
      "variants": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["sku", "price", "billingModel", "billingLabel"],
          "properties": {
            "sku": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
            "price": { "type": "number", "exclusiveMinimum": 0 },
            "billingModel": { "enum": ["one_time", "monthly", "annual", "setup", "support_annual", "qualified_sale"] },
            "billingLabel": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
